# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must never be committed.

# --- Required ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# The guild (server) the bot operates in.
DISCORD_GUILD_ID=

# Category where ModMail threads (private staff channels) are created.
# Optional: if unset, a category named "ModMail" is used or created.
MODMAIL_CATEGORY_ID=

# --- Optional ---------------------------------------------------------------
# Channel that receives a summary when a thread is closed.
LOG_CHANNEL_ID=

# Command prefix used inside staff threads.
COMMAND_PREFIX=?

# Database URL. SQLite for development; swap for PostgreSQL later without
# touching application code.
DATABASE_URL=sqlite+aiosqlite:///./modmail.db

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Directory for rotating log files.
LOG_DIR=./logs
